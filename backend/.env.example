# Which agent to serve: "demo" (default) or "food_discovery"
# AGENT=demo

# Required: OpenAI API key for the LLM
OPENAI_API_KEY=sk-...

# Optional: Route OpenAI calls through LiteLLM proxy
# LITELLM_BASE_URL=https://litellm.example.com

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=ls__...

# Optional: Google API key (if using Gemini models)
# GOOGLE_API_KEY=...

# Port the agent listens on inside the container (default: 8123)
# AGENT_PORT=8123

# CORS origins allowed to call the backend (comma-separated, default: *)
# CORS_ORIGINS=http://localhost:3000,https://yourfrontend.com
